# Import SQLite Library
import sqlite3

# Create Database
conn = sqlite3.connect("student.db")

# Create Cursor
cursor = conn.cursor()

# Create Table
cursor.execute("""

CREATE TABLE IF NOT EXISTS students (

    id INTEGER PRIMARY KEY,

    name TEXT,

    age INTEGER,

    marks INTEGER

)

""")

print("Table Created Successfully")

# Insert Data
cursor.execute(
    "INSERT INTO students VALUES (1, 'Abhinav', 20, 85)"
)

cursor.execute(
    "INSERT INTO students VALUES (2, 'Rahul', 21, 78)"
)

cursor.execute(
    "INSERT INTO students VALUES (3, 'Sneha', 19, 92)"
)

# Save Changes
conn.commit()

print("Data Inserted Successfully")

# Display All Records
cursor.execute("SELECT * FROM students")

rows = cursor.fetchall()

print("\nStudent Records:\n")

for row in rows:

    print(row)

# Query: Marks Greater Than 80
cursor.execute(
    "SELECT * FROM students WHERE marks > 80"
)

print("\nStudents with Marks > 80:\n")

print(cursor.fetchall())

# Average Marks
cursor.execute(
    "SELECT AVG(marks) FROM students"
)

print("\nAverage Marks:\n")

print(cursor.fetchone())

# Update Record
cursor.execute(
    "UPDATE students SET marks = 88 WHERE id = 2"
)

conn.commit()

print("\nRecord Updated Successfully")

# Delete Record
cursor.execute(
    "DELETE FROM students WHERE id = 1"
)

conn.commit()

print("\nRecord Deleted Successfully")

# Final Records
cursor.execute("SELECT * FROM students")

print("\nFinal Table Data:\n")

for row in cursor.fetchall():

    print(row)

# Close Connection
conn.close()

print("\nDatabase Connection Closed")


# ==========================================================
# EXTRA QUERIES
# ==========================================================

# Reconnect Database
conn = sqlite3.connect("student.db")

cursor = conn.cursor()

# Maximum Marks
cursor.execute(
    "SELECT MAX(marks) FROM students"
)

print("\nMaximum Marks:")

print(cursor.fetchone())

# Minimum Marks
cursor.execute(
    "SELECT MIN(marks) FROM students"
)

print("\nMinimum Marks:")

print(cursor.fetchone())

# Count Students
cursor.execute(
    "SELECT COUNT(*) FROM students"
)

print("\nTotal Students:")

print(cursor.fetchone())

# Sort by Marks
cursor.execute(
    "SELECT * FROM students ORDER BY marks DESC"
)

print("\nStudents Sorted by Marks:\n")

for row in cursor.fetchall():

    print(row)

# Students Age Greater Than 20
cursor.execute(
    "SELECT * FROM students WHERE age > 20"
)

print("\nStudents with Age > 20:\n")

print(cursor.fetchall())

# Close Connection
conn.close()


